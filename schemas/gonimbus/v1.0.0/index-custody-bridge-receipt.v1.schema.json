{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/gonimbus/v1.0.0/index-custody-bridge-receipt.v1.schema.json",
  "title": "Gonimbus Durable Custody Bridge Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "outcome",
    "source_handle_ref",
    "target_handle_ref",
    "index_set_id",
    "run_id",
    "legacy_marker_schema_version",
    "result_marker_schema_version",
    "legacy_marker_sha256",
    "source_identity_sha256",
    "source_identity_schema",
    "source_identity_profile",
    "manifest_sha256",
    "declared",
    "verification",
    "run_start",
    "snapshot_time",
    "conversion_identity_sha256",
    "result_complete_sha256",
    "operation_started_at",
    "operation_completed_at",
    "disposition"
  ],
  "properties": {
    "type": {
      "const": "gonimbus.index.custody_bridge_receipt.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "outcome": {
      "const": "success"
    },
    "source_handle_ref": {
      "$ref": "#/$defs/handle_ref"
    },
    "target_handle_ref": {
      "$ref": "#/$defs/handle_ref"
    },
    "index_set_id": {
      "$ref": "#/$defs/index_set_id"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "legacy_marker_schema_version": {
      "const": "gonimbus.index.hub_marker.v1"
    },
    "result_marker_schema_version": {
      "const": "gonimbus.index.hub_marker.v3"
    },
    "legacy_marker_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identity_schema": {
      "const": "gonimbus.index_set_identity.canonical-json-lf.v1"
    },
    "source_identity_profile": {
      "const": "default"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "segments"
      ],
      "properties": {
        "rows": {
          "$ref": "#/$defs/count"
        },
        "segments": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments_verified",
        "bytes_read",
        "bytes_conditionally_created"
      ],
      "properties": {
        "segments_verified": {
          "$ref": "#/$defs/count"
        },
        "bytes_read": {
          "$ref": "#/$defs/count"
        },
        "bytes_conditionally_created": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "run_start": {
      "$ref": "#/$defs/run_start"
    },
    "snapshot_time": {
      "$ref": "#/$defs/snapshot_time"
    },
    "conversion_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result_complete_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "operation_started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "operation_completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "disposition": {
      "enum": [
        "created",
        "already_identical"
      ]
    }
  },
  "$defs": {
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "handle_ref": {
      "type": "string",
      "pattern": "^hnd_[0-9a-f]{32}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "run_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "started_at"
      ],
      "properties": {
        "basis": {
          "const": "legacy_asserted"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "snapshot_time": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "completed_at",
            "evidence_type",
            "evidence_sha256"
          ],
          "properties": {
            "basis": {
              "const": "exact_commit"
            },
            "completed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "evidence_type": {
              "const": "gonimbus.index.complete.v2"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis"
          ],
          "properties": {
            "basis": {
              "const": "legacy_unavailable"
            }
          }
        }
      ]
    }
  }
}
