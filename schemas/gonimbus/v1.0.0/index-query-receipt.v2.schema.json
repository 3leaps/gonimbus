{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/gonimbus/v1.0.0/index-query-receipt.v2.schema.json",
  "title": "Gonimbus Index Query Receipt with Classified Time Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "outcome",
    "source_kind",
    "index_set_id",
    "run_id",
    "run_start",
    "snapshot_time",
    "source_identity_sha256",
    "source_identity_schema",
    "source_identity_profile",
    "manifest_sha256",
    "coverage_sha256",
    "coverage",
    "declared",
    "query",
    "results",
    "segments",
    "warnings",
    "errors"
  ],
  "properties": {
    "type": {
      "const": "gonimbus.index.query_receipt.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "outcome": {
      "const": "success"
    },
    "source_kind": {
      "enum": [
        "local_published",
        "acquired_hub"
      ]
    },
    "index_set_id": {
      "$ref": "#/$defs/index_set_id"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "run_start": {
      "$ref": "#/$defs/run_start"
    },
    "snapshot_time": {
      "$ref": "#/$defs/snapshot_time"
    },
    "hub_committed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "hub_complete_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identity_schema": {
      "enum": [
        "gonimbus/v1.0.0/index-hub-identity",
        "gonimbus.index_set_identity.canonical-json-lf.v1"
      ]
    },
    "source_identity_profile": {
      "enum": [
        "gonimbus.index_set_identity.canonical-json-lf.v1",
        "default"
      ]
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "coverage_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "declared": {
      "$ref": "#/$defs/declared"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "results": {
      "$ref": "#/$defs/results"
    },
    "segments": {
      "$ref": "#/$defs/segment_verification"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/code"
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "source_identity_schema": {
              "const": "gonimbus/v1.0.0/index-hub-identity"
            },
            "source_identity_profile": {
              "const": "gonimbus.index_set_identity.canonical-json-lf.v1"
            }
          }
        },
        {
          "properties": {
            "source_identity_schema": {
              "const": "gonimbus.index_set_identity.canonical-json-lf.v1"
            },
            "source_identity_profile": {
              "const": "default"
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "acquired_hub"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "required": [
          "hub_committed_at",
          "hub_complete_sha256"
        ]
      },
      "else": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "hub_committed_at"
                  ]
                },
                {
                  "required": [
                    "hub_complete_sha256"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "run_start": {
                "type": "object",
                "properties": {
                  "basis": {
                    "const": "locally_observed"
                  }
                },
                "required": [
                  "basis"
                ]
              },
              "snapshot_time": {
                "type": "object",
                "properties": {
                  "basis": {
                    "const": "exact_commit"
                  }
                },
                "required": [
                  "basis"
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "run_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "started_at"
      ],
      "properties": {
        "basis": {
          "enum": [
            "legacy_asserted",
            "locally_observed"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "snapshot_time": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "completed_at",
            "evidence_type",
            "evidence_sha256"
          ],
          "properties": {
            "basis": {
              "const": "exact_commit"
            },
            "completed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "evidence_type": {
              "const": "gonimbus.index.complete.v2"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis"
          ],
          "properties": {
            "basis": {
              "const": "legacy_unavailable"
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "complete_entries",
        "confirmed_entries",
        "inferred_entries",
        "gap_count"
      ],
      "properties": {
        "entries": {
          "$ref": "#/$defs/count"
        },
        "complete_entries": {
          "$ref": "#/$defs/count"
        },
        "confirmed_entries": {
          "$ref": "#/$defs/count"
        },
        "inferred_entries": {
          "$ref": "#/$defs/count"
        },
        "gap_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "active_rows",
        "tombstones",
        "distinct_etags",
        "segments"
      ],
      "properties": {
        "rows": {
          "$ref": "#/$defs/count"
        },
        "active_rows": {
          "$ref": "#/$defs/count"
        },
        "tombstones": {
          "$ref": "#/$defs/count"
        },
        "distinct_etags": {
          "$ref": "#/$defs/count"
        },
        "segments": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_spec_sha256",
        "result_mode",
        "filter_kinds",
        "filter_count",
        "storage_class_count",
        "include_alternates",
        "effective_limit"
      ],
      "properties": {
        "query_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_mode": {
          "enum": [
            "objects",
            "canonical_objects",
            "count",
            "canonical_count"
          ]
        },
        "filter_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pattern",
              "key_regex",
              "min_size",
              "max_size",
              "modified_after",
              "modified_before",
              "storage_class",
              "enriched_after",
              "include_deleted",
              "since_run"
            ]
          }
        },
        "filter_count": {
          "$ref": "#/$defs/count"
        },
        "storage_class_count": {
          "$ref": "#/$defs/count"
        },
        "baseline_run_id": {
          "$ref": "#/$defs/run_id"
        },
        "canonical_tie_break": {
          "enum": [
            "min-key",
            "min-modified",
            "max-modified"
          ]
        },
        "include_alternates": {
          "type": "boolean"
        },
        "effective_limit": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examined",
        "matched",
        "emitted",
        "logical_results",
        "truncated",
        "timestamp_parse_anomalies"
      ],
      "properties": {
        "examined": {
          "$ref": "#/$defs/count"
        },
        "matched": {
          "$ref": "#/$defs/count"
        },
        "emitted": {
          "$ref": "#/$defs/count"
        },
        "logical_results": {
          "$ref": "#/$defs/count"
        },
        "truncated": {
          "type": "boolean"
        },
        "timestamp_parse_anomalies": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "segment_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "walked",
        "verified",
        "manifest_pruned"
      ],
      "properties": {
        "declared": {
          "$ref": "#/$defs/count"
        },
        "walked": {
          "$ref": "#/$defs/count"
        },
        "verified": {
          "$ref": "#/$defs/count"
        },
        "manifest_pruned": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
