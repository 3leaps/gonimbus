{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gonimbus/v1.0.0/index-hub-complete",
  "title": "Gonimbus Index Hub Complete Marker",
  "description": "Commit marker for an exported SQLite or durable index run. Written last after every required artifact is uploaded.",
  "type": "object",
  "required": [
    "version",
    "index_set_id",
    "run_id",
    "completed_at",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema reference for editor support"
    },
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Complete marker schema version"
    },
    "marker_schema_version": {
      "type": "string",
      "enum": [
        "gonimbus.index.hub_marker.v1",
        "gonimbus.index.hub_marker.v2"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "sqlite-v1",
        "durable-v2"
      ]
    },
    "format_version": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ]
    },
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$",
      "description": "Full index set identity hash"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$",
      "description": "Run identifier (run_<unixnano> or run_<ulid>)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Compatibility timestamp for the hub commit (RFC 3339)"
    },
    "snapshot_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the source durable snapshot completed"
    },
    "hub_committed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When publication of the hub run committed"
    },
    "exported_by": {
      "type": "string",
      "description": "Tool and version that performed the export (e.g., gonimbus/0.1.8)"
    },
    "artifacts": {
      "type": "object",
      "description": "Checksums and sizes of exported artifacts for integrity verification",
      "additionalProperties": false,
      "properties": {
        "index_db": {
          "$ref": "#/$defs/artifact_entry"
        },
        "identity_json": {
          "$ref": "#/$defs/artifact_entry"
        },
        "manifest": {
          "$ref": "#/$defs/artifact_entry"
        },
        "segments": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/artifact_entry"
          }
        }
      }
    },
    "durable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_type",
        "manifest_render",
        "index_schema_version",
        "segment_namespace",
        "segments",
        "rows"
      ],
      "properties": {
        "manifest_type": {
          "type": "string"
        },
        "manifest_render": {
          "type": "string"
        },
        "index_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "segment_namespace": {
          "type": "string"
        },
        "segments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Provenance of the exported index run",
      "additionalProperties": false,
      "properties": {
        "base_uri": {
          "type": "string",
          "description": "The base URI this index covers"
        },
        "provider": {
          "type": "string",
          "description": "Storage provider (e.g., s3)"
        },
        "run_status": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failed",
            "failed-resumable"
          ],
          "description": "Status of the source run at export time"
        },
        "run_started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the source run started"
        },
        "run_ended_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the source run ended"
        },
        "object_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of objects in the index at export time"
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total size of indexed objects in bytes"
        }
      }
    },
    "provider_meta": {
      "type": "object",
      "description": "Provider-opaque hints (e.g., GCS generation). Values are strings; keys are provider-specific.",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "format"
        ],
        "properties": {
          "format": {
            "const": "durable-v2"
          }
        }
      },
      "then": {
        "required": [
          "marker_schema_version",
          "format_version",
          "exported_by",
          "durable"
        ],
        "properties": {
          "format_version": {
            "const": "2"
          },
          "artifacts": {
            "required": [
              "manifest",
              "segments"
            ],
            "properties": {
              "manifest": {
                "$ref": "#/$defs/durable_artifact_entry"
              },
              "segments": {
                "items": {
                  "$ref": "#/$defs/durable_artifact_entry"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": {
            "required": [
              "index_db"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "marker_schema_version"
        ],
        "properties": {
          "marker_schema_version": {
            "const": "gonimbus.index.hub_marker.v2"
          }
        }
      },
      "then": {
        "required": [
          "format",
          "snapshot_completed_at",
          "hub_committed_at"
        ],
        "properties": {
          "format": {
            "const": "durable-v2"
          },
          "artifacts": {
            "required": [
              "identity_json"
            ],
            "properties": {
              "identity_json": {
                "$ref": "#/$defs/durable_artifact_entry"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact_entry": {
      "type": "object",
      "description": "Checksum and size of a single exported artifact",
      "required": [
        "size_bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Artifact size in bytes"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 hex digest of the artifact content"
        },
        "etag": {
          "type": "string",
          "description": "Provider ETag returned after upload (for cache validation)"
        }
      }
    },
    "durable_artifact_entry": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_entry"
        },
        {
          "required": [
            "path",
            "role",
            "required"
          ]
        }
      ]
    }
  }
}
