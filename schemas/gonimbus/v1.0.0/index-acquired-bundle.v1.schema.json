{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/gonimbus/v1.0.0/index-acquired-bundle.v1.schema.json",
  "title": "Gonimbus Acquired Index Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "index_set_id",
    "run_id",
    "source_identity_sha256",
    "source_identity_schema",
    "source_identity_profile",
    "snapshot_completed_at",
    "hub_committed_at",
    "hub_complete_sha256",
    "manifest_sha256",
    "acquired_at",
    "lineage",
    "artifacts"
  ],
  "properties": {
    "type": {
      "const": "gonimbus.index.acquired_bundle.v1"
    },
    "schema": {
      "const": "gonimbus/v1.0.0/index-acquired-bundle.v1"
    },
    "index_set_id": {
      "$ref": "#/$defs/index_set_id"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "proof_through_run_id": {
      "$ref": "#/$defs/run_id"
    },
    "source_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identity_schema": {
      "const": "gonimbus/v1.0.0/index-hub-identity"
    },
    "source_identity_profile": {
      "const": "gonimbus.index_set_identity.canonical-json-lf.v1"
    },
    "snapshot_completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "hub_committed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "hub_complete_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "acquired_at": {
      "$ref": "#/$defs/timestamp"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index_set_id",
          "run_id",
          "hub_complete_sha256",
          "manifest_sha256"
        ],
        "properties": {
          "index_set_id": {
            "$ref": "#/$defs/index_set_id"
          },
          "run_id": {
            "$ref": "#/$defs/run_id"
          },
          "hub_complete_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "manifest_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 200192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(identity\\.json|runs/run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})/(hub-complete\\.json|manifest\\.json|complete\\.json|segments/[A-Za-z0-9._-]+))$"
          },
          "role": {
            "enum": [
              "source_identity",
              "hub_complete",
              "manifest",
              "segment",
              "local_complete"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
