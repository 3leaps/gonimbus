{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/gonimbus/v1.0.0/index-complete.v2.schema.json",
  "title": "Gonimbus Durable Index Complete Marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "index_set_id",
    "run_id",
    "snapshot_completed_at",
    "snapshot_completion_semantics",
    "manifest_path",
    "manifest_sha256",
    "segment_dir",
    "segments"
  ],
  "properties": {
    "type": {
      "const": "gonimbus.index.complete.v2"
    },
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "snapshot_completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "snapshot_completion_semantics": {
      "const": "complete_marker_commit"
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segment_dir": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "integer",
      "minimum": 0
    }
  }
}
