{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/gonimbus/v1.0.0/index-custody-bridge-conversion.v1.schema.json",
  "title": "Gonimbus Durable Custody Bridge Conversion Identity",
  "description": "Stable conversion identity encoded as gonimbus.canonical-ordered-json-lf.v1. Object and nested member order are fixed by that encoding profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "index_set_id",
    "run_id",
    "legacy_marker_sha256",
    "identity_sha256",
    "identity_schema",
    "identity_profile",
    "manifest_sha256",
    "segments",
    "run_start",
    "snapshot_time"
  ],
  "properties": {
    "type": {
      "const": "gonimbus.index.custody_bridge_conversion.v1"
    },
    "index_set_id": {
      "$ref": "#/$defs/index_set_id"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "legacy_marker_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "identity_schema": {
      "const": "gonimbus.index_set_identity.canonical-json-lf.v1"
    },
    "identity_profile": {
      "const": "default"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "segments": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "run_start": {
      "$ref": "#/$defs/run_start"
    },
    "snapshot_time": {
      "$ref": "#/$defs/snapshot_time"
    }
  },
  "$defs": {
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "run_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "started_at"
      ],
      "properties": {
        "basis": {
          "const": "legacy_asserted"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "snapshot_time": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "completed_at",
            "evidence_type",
            "evidence_sha256"
          ],
          "properties": {
            "basis": {
              "const": "exact_commit"
            },
            "completed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "evidence_type": {
              "const": "gonimbus.index.complete.v2"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis"
          ],
          "properties": {
            "basis": {
              "const": "legacy_unavailable"
            }
          }
        }
      ]
    }
  }
}
