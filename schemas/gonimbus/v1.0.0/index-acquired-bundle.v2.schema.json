{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/gonimbus/v1.0.0/index-acquired-bundle.v2.schema.json",
  "title": "Gonimbus Acquired Durable Custody Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "index_set_id",
    "run_id",
    "source_identity_sha256",
    "source_identity_schema",
    "source_identity_profile",
    "hub_marker_schema_version",
    "run_start",
    "snapshot_time",
    "conversion_identity_sha256",
    "hub_committed_at",
    "hub_complete_sha256",
    "manifest_sha256",
    "acquired_at",
    "lineage",
    "artifacts"
  ],
  "properties": {
    "type": {
      "const": "gonimbus.index.acquired_bundle.v2"
    },
    "schema": {
      "const": "gonimbus/v1.0.0/index-acquired-bundle.v2"
    },
    "index_set_id": {
      "$ref": "#/$defs/index_set_id"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "proof_through_run_id": {
      "$ref": "#/$defs/run_id"
    },
    "source_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_identity_schema": {
      "const": "gonimbus.index_set_identity.canonical-json-lf.v1"
    },
    "source_identity_profile": {
      "const": "default"
    },
    "hub_marker_schema_version": {
      "const": "gonimbus.index.hub_marker.v3"
    },
    "run_start": {
      "$ref": "#/$defs/run_start"
    },
    "snapshot_time": {
      "$ref": "#/$defs/snapshot_time"
    },
    "conversion_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "hub_committed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "hub_complete_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "acquired_at": {
      "$ref": "#/$defs/timestamp"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index_set_id",
              "run_id",
              "marker_schema_version",
              "hub_complete_sha256",
              "manifest_sha256"
            ],
            "properties": {
              "index_set_id": {
                "$ref": "#/$defs/index_set_id"
              },
              "run_id": {
                "$ref": "#/$defs/run_id"
              },
              "marker_schema_version": {
                "const": "gonimbus.index.hub_marker.v2"
              },
              "hub_complete_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "manifest_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index_set_id",
              "run_id",
              "marker_schema_version",
              "hub_complete_sha256",
              "manifest_sha256",
              "conversion_identity_sha256"
            ],
            "properties": {
              "index_set_id": {
                "$ref": "#/$defs/index_set_id"
              },
              "run_id": {
                "$ref": "#/$defs/run_id"
              },
              "marker_schema_version": {
                "const": "gonimbus.index.hub_marker.v3"
              },
              "hub_complete_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "manifest_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "conversion_identity_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 200128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(identity\\.json|runs/run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})/(hub-complete\\.json|manifest\\.json|segments/[A-Za-z0-9._-]+))$"
          },
          "role": {
            "enum": [
              "source_identity",
              "hub_complete",
              "manifest",
              "segment"
            ]
          },
          "size_bytes": {
            "$ref": "#/$defs/count"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "index_set_id": {
      "type": "string",
      "pattern": "^idx_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_([0-9]{1,32}|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "run_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "started_at"
      ],
      "properties": {
        "basis": {
          "const": "legacy_asserted"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "snapshot_time": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "completed_at",
            "evidence_type",
            "evidence_sha256"
          ],
          "properties": {
            "basis": {
              "const": "exact_commit"
            },
            "completed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "evidence_type": {
              "const": "gonimbus.index.complete.v2"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis"
          ],
          "properties": {
            "basis": {
              "const": "legacy_unavailable"
            }
          }
        }
      ]
    }
  }
}
