{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:durable-index/v0/index-row.schema.json",
  "title": "Object Inventory Logical Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "key",
    "revision",
    "size_bytes",
    "last_modified",
    "storage_class",
    "first_seen",
    "last_seen",
    "last_changed",
    "deleted",
    "enrichments"
  ],
  "properties": {
    "namespace": {
      "$ref": "#/$defs/id"
    },
    "key": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1,
      "description": "Unicode scalar string; maximum 4096 UTF-8 bytes, enforced by semantic validation in addition to the JSON Schema code-point bound."
    },
    "revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "size_bytes": {
      "$ref": "#/$defs/count"
    },
    "last_modified": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_seen": {
      "$ref": "#/$defs/stamp"
    },
    "last_seen": {
      "$ref": "#/$defs/stamp"
    },
    "last_changed": {
      "$ref": "#/$defs/stamp"
    },
    "deleted": {
      "anyOf": [
        {
          "$ref": "#/$defs/stamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "enrichments": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/enrichment"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "at"],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "operation", "observed_at", "against_revision"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "value": {
          "type": ["string", "null"],
          "maxLength": 65536
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "observed_at": {
          "$ref": "#/$defs/instant"
        },
        "against_revision": {
          "$ref": "#/$defs/revision"
        }
      }
    }
  }
}
