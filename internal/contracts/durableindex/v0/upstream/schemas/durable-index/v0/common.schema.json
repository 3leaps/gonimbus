{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:durable-index/v0/common.schema.json",
  "title": "Durable Index Shared Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "$ref": "contract:segmented-snapshot/v0/common.schema.json#/$defs/binding"
    },
    "selection": {
      "$ref": "contract:segmented-snapshot/v0/common.schema.json#/$defs/selection"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "contains": {
        "const": "contract: durable-index/v0"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "prefix"],
      "properties": {
        "namespace": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/id"
        },
        "prefix": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/text",
          "description": "Unicode scalar string; maximum 4096 UTF-8 bytes, enforced by semantic validation in addition to the JSON Schema code-point bound."
        }
      }
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "at"],
      "properties": {
        "snapshot_id": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/id"
        },
        "at": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/instant"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "publication"],
      "properties": {
        "selection": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/selection"
        },
        "publication": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/binding"
        }
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "operation", "observed_at", "against_revision"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "value": {
          "type": ["string", "null"],
          "maxLength": 65536
        },
        "operation": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/id"
        },
        "observed_at": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/instant"
        },
        "against_revision": {
          "$ref": "contract:durable-index/v0/common.schema.json#/$defs/revision"
        }
      }
    }
  }
}
